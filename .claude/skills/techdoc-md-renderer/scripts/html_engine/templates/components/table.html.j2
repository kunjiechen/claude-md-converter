<table class="table {{ table_class }}">
{% if has_header %}
<thead>
<tr>{% for cell in header_cells %}<th class="align-{{ cell.align }}">{{ cell.content }}</th>{% endfor %}</tr>
</thead>
{% endif %}
<tbody>
{% for row in rows %}
<tr>{% for cell in row %}<td class="align-{{ cell.align }}">{{ cell.content }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
