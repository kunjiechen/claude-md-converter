<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title | default('文档索引') }}</title>
<style>
:root {
    --font-body: "Microsoft YaHei", "微软雅黑", sans-serif;
    --color-text: #333;
    --color-bg: #fff;
    --color-link: #0563C1;
    --color-border: #e0e0e0;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-body); max-width: 800px; margin: 40px auto; padding: 20px; background: var(--color-bg); color: var(--color-text); }
h1 { font-size: 1.8em; margin-bottom: 8px; border-bottom: 2px solid var(--color-border); padding-bottom: 12px; }
.index-description { color: #888; margin-bottom: 24px; font-size: 0.95em; }
.file-list { list-style: none; }
.file-item { margin: 10px 0; padding: 12px 16px; border: 1px solid var(--color-border); border-radius: 4px; transition: background 0.15s; }
.file-item:hover { background: #f5f5f5; }
.file-link { font-size: 1.1em; color: var(--color-link); text-decoration: none; font-weight: 500; }
.file-link:hover { text-decoration: underline; }
.file-meta { font-size: 0.85em; color: #999; margin-top: 4px; }
.index-footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--color-border); font-size: 0.85em; color: #aaa; }
</style>
</head>
<body>
<h1>{{ title | default('文档索引') }}</h1>
{% if description %}<p class="index-description">{{ description }}</p>{% endif %}
<ul class="file-list">
{% for entry in entries %}
  <li class="file-item">
    <a class="file-link" href="{{ entry.href }}">{{ entry.title }}</a>
    {% if entry.meta %}
    <div class="file-meta">{{ entry.meta }}</div>
    {% endif %}
  </li>
{% endfor %}
</ul>
<div class="index-footer">
  <p>{{ entries|length }} 个文档 &middot; 由 md-converter 生成</p>
</div>
</body>
</html>
